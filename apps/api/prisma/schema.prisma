generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Worker {
  id         String    @id @default(cuid())
  name       String
  phone      String    @unique
  area       String
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  families  Family[]
  graves    Grave[]
  orders    Order[]
}

model Family {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
  graves     Grave[]

  @@index([customerId])
}

model Grave {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  familyId   String?
  family     Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)
  fullName   String
  birthYear  Int?
  deathYear  Int?
  city       String
  cemetery   String
  landmarks  String?
  biography  String?
  keepOff    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]

  @@index([customerId])
  @@index([familyId])
}

model Order {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  graveId    String
  grave      Grave    @relation(fields: [graveId], references: [id], onDelete: Restrict)
  service      String
  serviceTitle String   @default("")
  details      String?
  wishes       String?
  price      Int
  desiredOn  DateTime @db.Date
  status     String   @default("open")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
  @@index([graveId])
  @@index([status])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Int
  icon        String?
  sort        Int
  createdAt   DateTime @default(now())
}

model PhoneCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}
