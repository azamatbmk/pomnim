{
  "name": "@pomnim/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@pomnim/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "6.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas-build-post-install": "cd ../.. && npm run build --workspace @pomnim/shared",
    "build:preview": "npx eas-cli build --profile preview --platform android",
    "build:production": "npx eas-cli build --profile production --platform android",
    "submit": "npx eas-cli submit --profile production --platform android"
  }
}
